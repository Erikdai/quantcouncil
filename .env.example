# --- LLM (any provider TradingAgents supports; DeepSeek by default) ---
DEEPSEEK_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# US prices/news use Yahoo Finance without a key; statements use SEC EDGAR.
# Identify your SEC requests with your own name and contact email:
# SEC_EDGAR_USER_AGENT=Your Name your-email@example.com
# DASHSCOPE_API_KEY=

# --- Platform (defaults match docker compose; local dev uses these host ports) ---
# QUANTCOUNCIL_DATABASE_URL=postgresql+psycopg://quantcouncil:quantcouncil@127.0.0.1:15432/quantcouncil
# QUANTCOUNCIL_REDIS_URL=redis://:quantcouncil-redis@127.0.0.1:6379/0
# QUANTCOUNCIL_MCP_URL=http://127.0.0.1:8001/mcp
# QUANTCOUNCIL_INITIAL_CASH=1000000
# QUANTCOUNCIL_SECRET_KEY=change-me   # encrypts API keys entered in the UI settings page
# POSTGRES_PASSWORD=quantcouncil
# REDIS_AUTH=quantcouncil-redis

# --- Risk limits enforced by the risk gate ---
# RISK_MAX_POSITION_PCT=0.10
# RISK_MAX_DRAWDOWN_PCT=0.15

# --- Observability (docker compose --profile observability) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-quantcouncil-local
# LANGFUSE_SECRET_KEY=sk-lf-quantcouncil-local
# LANGFUSE_HOST=http://localhost:3000
