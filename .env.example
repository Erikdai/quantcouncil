# --- LLM (any provider TradingAgents supports; DeepSeek by default) ---
DEEPSEEK_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=

# --- Platform (defaults match docker compose; local dev uses these host ports) ---
# FINAGENT_DATABASE_URL=postgresql+psycopg://finagent:finagent@127.0.0.1:15432/finagent
# FINAGENT_REDIS_URL=redis://:finagent-redis@127.0.0.1:6379/0
# FINAGENT_MCP_URL=http://127.0.0.1:8001/mcp
# FINAGENT_INITIAL_CASH=1000000
# FINAGENT_SECRET_KEY=change-me   # encrypts API keys entered in the UI settings page
# POSTGRES_PASSWORD=finagent
# REDIS_AUTH=finagent-redis

# --- Risk limits enforced by the risk gate ---
# RISK_MAX_POSITION_PCT=0.10
# RISK_MAX_DRAWDOWN_PCT=0.15

# --- Observability (docker compose --profile observability) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-finagent-local
# LANGFUSE_SECRET_KEY=sk-lf-finagent-local
# LANGFUSE_HOST=http://localhost:3000
